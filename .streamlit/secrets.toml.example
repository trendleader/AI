# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Community Cloud
# -> App settings -> Secrets. Never commit the real secrets.toml.
# (In TOML, plain keys must come BEFORE the first [section] header.)

# ── Results mode ─────────────────────────────────────────────
# "instructor" (default): student does NOT see a score; the attempt is locked
#                         until you release it from the Instructor panel.
# "immediate":            student sees the score as soon as they submit.
RESULTS_MODE = "instructor"

# Password for the Instructor panel (required to view, grade and release results).
INSTRUCTOR_PASSWORD = "choose-a-strong-password"

# ── Google Sheets storage (needed on Streamlit Community Cloud) ─────────────
# 1. In Google Cloud Console create a project, enable the "Google Sheets API",
#    then create a Service Account and download a JSON key for it.
# 2. Create an empty Google Sheet and share it (Editor) with the service
#    account's client_email.
# 3. Paste the sheet URL below and copy the fields of the JSON key into
#    [gcp_service_account]. Keep the \n line breaks inside private_key.
# Leave these out to store submissions as local files in ./exam_submissions.
GSHEET_URL = "https://docs.google.com/spreadsheets/d/your-sheet-id/edit"

# ── E-mail notification ──────────────────────────────────────
# Gmail: turn on 2-Step Verification for the sending account, then create an
# App Password at https://myaccount.google.com/apppasswords and use it below.
[smtp]
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "your-sending-account@gmail.com"
SMTP_PASSWORD = "your-16-character-app-password"
SMTP_FROM = "your-sending-account@gmail.com"
NOTIFY_EMAIL = "philjones820@gmail.com"

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "exam-app@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
